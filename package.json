{
  "name": "codeforces-leetcode-tracker",
  "version": "1.0.0",
  "description": "Unified tracker for Codeforces and LeetCode questions, contests, and ratings",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/tailwind.css --minify",
    "build": "npm run build:css"
  },
  "keywords": [
    "codeforces",
    "leetcode",
    "competitive-programming",
    "tracker",
    "ratings",
    "contests"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.5.1",
    "express": "^4.21.2",
    "lucide": "^1.57.0",
    "tailwindcss": "^3.4.19"
  }
}
